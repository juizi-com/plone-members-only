<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <!-- Example upgrade step
  <genericsetup:upgradeSteps
      profile="collective.membersonly:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Update registry value"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>
  -->

  <genericsetup:upgradeStep
      title="Subscription role"
      description="Members-only content is read by a Sharing role; existing sites keep any-logged-in-user access."
      profile="collective.membersonly:default"
      source="1000"
      destination="1001"
      handler=".to_1001"
      />

  <genericsetup:upgradeStep
      title="Teaser field extension point"
      description="Other add-ons can offer teaser fields; listings know what's members-only."
      profile="collective.membersonly:default"
      source="1001"
      destination="1002"
      handler=".to_1002"
      />

</configure>
