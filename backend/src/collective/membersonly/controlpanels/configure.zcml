<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.membersonly"
    >

  <browser:page
      name="members-only-controlpanel"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.MembersOnlyControlPanelView"
      permission="cmf.ManagePortal"
      />

  <adapter factory=".controlpanel.MembersOnlyConfigletPanel" name="members-only" />

  <subscriber
      for=".controlpanel.IMembersOnlySettings
           plone.registry.interfaces.IRecordModifiedEvent"
      handler="..access.setting_changed" />

</configure>